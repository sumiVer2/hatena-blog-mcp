# 認証に使うアカウントのはてなID（API キーの持ち主）
HATENA_ID=your-hatena-id

# ブログID（例: tech.example.hatenablog.com）
# 独自ドメイン運用の場合は、独自ドメイン設定前のドメインを指定する
HATENA_BLOG_ID=your-blog.hatenablog.com

# AtomPub 用の API キー
# はてなブログの [設定] > [詳細設定] > [AtomPub] から取得する
HATENA_API_KEY=your-api-key

# ルートエンドポイント https://blog.hatena.ne.jp/{ここ}/{ブログID}/atom のはてなID。
# ブログの所有者を指す。自分が所有するブログなら省略でよい（HATENA_ID が使われる）。
# 会社のテックブログなど、所有者と操作者が異なる共有ブログでのみ指定する。
# HATENA_BLOG_OWNER_ID=blog-owner-id
