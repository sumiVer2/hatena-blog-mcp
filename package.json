{
  "name": "hatena-blog-mcp",
  "version": "0.1.0",
  "description": "はてなブログ AtomPub API 用の MCP サーバー",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "dev": "tsx src/index.ts",
    "inspect": "pnpm dlx @modelcontextprotocol/inspector tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "prepare": "tsc"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fast-xml-parser": "^5.11.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "bin": {
    "hatena-blog-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
